#version 450
// (relink, 0.7.9.3) DLSS Frame Generation's HUD-less picture (vk_dlss.cpp fg_capture): the upscale's picture before the game
// draws its HUD over it (linear colour), encoded as the window's sRGB texture holds it, which the backbuffer frame generation is
// given is a copy of (vk_framegen.cpp). Measured against a shot of that backbuffer at the Market, outside the HUD: the linear
// copy was 37.5 / 255 off on average, sRGB-encoded 1.25.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D src;
layout(binding = 1, rgba8) uniform writeonly image2D dst;
layout(push_constant) uniform P { ivec2 offset; ivec2 size; } pc;
vec3 srgb(vec3 c) {
    c = clamp(c, 0.0, 1.0);
    return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c));
}
void main() {
    const ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(g, pc.size))) return;
    imageStore(dst, g, vec4(srgb(texelFetch(src, g + pc.offset, 0).rgb), 1.0));
}
